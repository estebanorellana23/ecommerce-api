# Backend de repositorios: "memory" (por defecto, sin setup) o "sql"
REPO_BACKEND=memory

# Conexión a base de datos (solo si REPO_BACKEND=sql)
DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5432/ecommerce

# Pasarela de pago activa: "visanet" o "paypal"
PAYMENT_PROVIDER=visanet

# Umbral por defecto para reporte de stock bajo
LOW_STOCK_THRESHOLD=10

# Correos del equipo de compras (separados por coma)
PURCHASING_EMAILS=compras@empresa.gt
